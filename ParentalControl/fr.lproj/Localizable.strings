// Role-specific text onboarding.
"setup.parent.title" = "Gérez le temps d’écran de votre enfant";
"setup.parent.body" = "Définissez une limite quotidienne, des horaires et des tâches récompensées par du temps supplémentaire dans les apps. Consultez le temps restant et demandez la position de votre enfant.\n\nSur votre téléphone, seules les notifications sont nécessaires. Les autres autorisations se règlent sur le téléphone de votre enfant.";
"setup.child.title" = "Configurez le téléphone de votre enfant";
