"setup.apps.body" = "Limit va bloklash uchun ilovalar, toifalar yoki saytlarni tanlang. Boshqalari ochiq qoladi.\n\nTanlovni o‘zgartirishga ota-ona PIN kodi kerak.";
"setup.back" = "Orqaga";
"setup.check.child" = "Quyidagi sozlamalarni tekshiring; qaytish uchun bosing. O‘chirishdan himoya ixtiyoriy.\n\nO‘tkazilganlarni keyin tugatsa bo‘ladi. Oxirida ota-ona rejimi yopiladi.";
"setup.check.parent" = "Quyidagi holatni tekshiring. Qaytish uchun bandni bosing.\n\nBola telefonini ham sozlang: ruxsatlar va bloklanadigan ilovalar. O‘tkazilgan bosqichlarni keyin sozlamalarda tugatish mumkin.";
"setup.check.title" = "Sozlamalarni tekshirish";
"setup.child.body" = "Bu bosqichlarni ota-onang bilan bajar. Ruxsatlar tanlangan ilovalar vaqtini hisoblash, cheklash va joylashuvni ota-onaga yuborish uchun kerak.";
"setup.child.finish_body" = "Bosh ekranda ota-ona telefonidan kodni kiriting.\n\nOta-ona o‘z telefonida PIN o‘rnatadi. Keyin bu yerda: Ota-ona → PIN → Bloklash ro‘yxati, ilovalarni tanlang.\n\nKunlik limit ota-ona telefonida belgilanadi.";
"setup.child.title" = "Bola telefonini sozlang";
"setup.finish.action" = "Ilovani ochish";
"setup.finish.title" = "Keyingi qadamlar";
"setup.install.body" = "Bola telefoniga shu ilova kerak. [Bolaga havolani yuboring](%@) yoki uning kamerasi bilan QR kodni skanerlab o‘rnating.\n\nIlk ochishda “Bola telefoni”ni tanlang. Keyin telefonlarni bog‘laymiz.";
"setup.install.qr.accessibility" = "App Store’dan o‘rnatish QR kodi";
