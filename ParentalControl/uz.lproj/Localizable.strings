"setup.link.child" = "Ota-ona telefonida sozlash vaqtida kod yarating va pastga kiriting. Sozlash tugagan bo‘lsa: Sozlamalar → Bola bilan aloqa.";
"setup.link.parent" = "Bog‘lash kodini yaratib, bola telefoniga kiriting. Tasdiq shu yerda ko‘rinadi.\n\nKeyin ikkala telefonda sozlashni davom ettiring.";
"setup.link.required" = "Avval ota-ona va bola telefonlarini bog‘lang. Buni keyinroq ham qilish mumkin.";
"setup.link.wait" = "Bola telefoni kutilmoqda";
"setup.location.body" = "Ota-ona bola joylashuvini ko‘rishi uchun avval “Ilovadan foydalanganda”, keyin “Har doim” ruxsatini bering.\n\nJoylashuv faqat ota-ona so‘raganda tekshiriladi. Funksiya uchun “Har doim” kerak.";
"setup.notifications.child.body" = "Vaqt, bloklash va vazifalar haqidagi bildirishnomalarni yoqing.\n\nUlarsiz bola muhim xabarlarni o‘tkazib yuborishi mumkin.";
"setup.pairing.title" = "Ikki telefonni bog‘lang";
"setup.parent.body" = "Limit, jadvallar va ilovalarda qo‘shimcha vaqt beradigan vazifalar belgilang. Qolgan vaqtni ko‘ring va bola joylashuvini so‘rang.\n\nTelefoningizga faqat bildirishnoma ruxsati kerak. Boshqa ruxsatlar bola telefonida beriladi.";
"setup.parent.finish_body" = "Bog‘lagach, sozlamalarda ota-ona PIN kodini o‘rnating. U bola telefonidagi sozlamalarni himoyalaydi.\n\nBosh ekranda kunlik limit belgilang. U faqat bola telefonida tanlangan ilovalarga taalluqli.";
"setup.parent.pairing_body" = "Telefoningizda: Sozlamalar → Bola bilan aloqa, kod yarating.\n\nBola telefoniga shu ilovani o‘rnatib, Bola telefonini tanlang. Sozlagach, kodni uning bosh ekraniga kiriting.";
