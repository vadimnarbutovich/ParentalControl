"setup.permission.missing" = "Yoqilmagan";
"setup.pin.child" = "PIN faqat ota-ona telefonida, Ota-ona PIN kodi bosqichida yoki sozlamalarda o‘rnatiladi.\n\nIlovalar va himoyani tanlash uchun shu yerga kiriting. Kelmagan bo‘lsa, Ulanishni tekshirishni bosing.";
"setup.pin.enter" = "PINni kiritish";
"setup.pin.parent" = "Bola telefonidagi ota-ona sozlamalarini himoyalash uchun 4 xonali PIN o‘rnating.\n\nSaqlagach, davom etish uchun uni bola telefoniga kiriting.";
