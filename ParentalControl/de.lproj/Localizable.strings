"onboarding.location.body" = "Erlaube den Standortzugriff, damit deine Eltern dieses Gerät auf der Karte finden können. Für Anfragen im Hintergrund wird „Immer“ benötigt. Der Standort wird nur auf Anfrage deiner Eltern ermittelt, nicht dauerhaft.";
// Role-specific text onboarding.
"setup.parent.title" = "Bildschirmzeit deines Kindes steuern";
"setup.parent.body" = "Lege ein Tageslimit, Zeitpläne und Aufgaben mit zusätzlicher Zeit in Apps als Belohnung fest. Sieh die verbleibende Zeit und frage den Standort deines Kindes ab.\n\nAuf deinem Telefon benötigen wir nur Mitteilungen. Weitere Berechtigungen richten wir auf dem Telefon deines Kindes ein.";
"setup.child.title" = "Telefon des Kindes einrichten";
"setup.child.body" = "Geht diese Schritte gemeinsam mit einem Elternteil durch. Die Berechtigungen ermöglichen es, die Nutzung ausgewählter Apps zu erfassen, Einschränkungen anzuwenden und den Eltern den Standort zu zeigen.";
"setup.screen_time.body" = "Erlaube den Zugriff auf die Bildschirmzeit, um die Nutzung ausgewählter Apps zu erfassen und sie nach Zeitlimit, Zeitplan oder auf Wunsch der Eltern zu sperren.\n\nOhne diese Berechtigung funktionieren die Einschränkungen nicht.";
"setup.notifications.child.body" = "Erlaube Mitteilungen, damit dein Kind Änderungen der verfügbaren Zeit, Sperren und Nachrichten zu Aufgaben sieht.\n\nOhne Mitteilungen können wichtige Nachrichten übersehen werden.";
"setup.location.body" = "Damit Eltern den Standort ihres Kindes sehen können, erlaube den Standortzugriff: zuerst „Beim Verwenden der App“, dann „Immer“.\n\nDer Standort wird nur auf Anfrage der Eltern ermittelt. Zum Ermitteln des Standorts ist der Zugriff „Immer“ erforderlich.";
"setup.pairing.title" = "Beide Telefone verbinden";
"setup.parent.pairing_body" = "Öffne auf deinem Telefon Einstellungen → Verbindung zum Kind und erstelle einen Verbindungscode.\n\nInstalliere dieselbe App auf dem Telefon deines Kindes und wähle „Telefon des Kindes“. Gib nach der Einrichtung den Code auf dessen Startseite ein.";
"setup.protection.body" = "Damit dein Kind die App nicht löschen kann, muss sein Kinderaccount zu einer Apple-Familienfreigabe gehören.\n\nNach dem Verbinden kann ein Elternteil den Schutz auf dem Telefon des Kindes aktivieren: Elternteil → PIN → Einstellungen → Schutz vor dem Löschen.\n\nDie App funktioniert auch ohne diesen Schutz, kann dann aber vom Kind gelöscht werden.";
"setup.finish.title" = "Nächste Schritte";
"setup.parent.finish_body" = "Lege nach dem Verbinden der Telefone in den Einstellungen eine Eltern-PIN fest. Sie schützt die Einstellungen auf dem Telefon deines Kindes.\n\nLege auf der Startseite ein Tageslimit fest. Es gilt nur für die auf dem Telefon deines Kindes ausgewählten Apps.";
"setup.child.finish_body" = "Gib auf der Startseite den Verbindungscode vom Telefon des Elternteils ein.\n\nNach dem Verbinden legt ein Elternteil auf seinem eigenen Telefon eine PIN fest. Wählt dann auf diesem Telefon unter Elternteil → PIN → Sperrliste die zu verwaltenden Apps aus.\n\nDas Tageslimit wird auf dem Telefon des Elternteils festgelegt.";
"setup.permission.enabled" = "Erlaubt";
"setup.permission.missing" = "Nicht aktiviert";
"setup.finish.action" = "App öffnen";
"setup.back" = "Zurück";
"role.select.parent" = "Telefon der Eltern";
"role.select.child" = "Telefon des Kindes";

// Guided pairing and setup.
"setup.install.title" = "App auf dem Telefon des Kindes installieren";
"setup.install.body" = "Auf dem Telefon deines Kindes wird dieselbe App benötigt. [Schicke deinem Kind den Link](%@) oder scanne den QR-Code mit der Kamera seines Telefons, um die App zu installieren.\n\nWähle beim ersten Start „Telefon des Kindes“ — als Nächstes verbinden wir die Telefone.";
"setup.install.qr.accessibility" = "QR-Code zum Installieren der App aus dem App Store";
"setup.link.parent" = "Erstelle einen Verbindungscode und gib ihn auf dem Telefon deines Kindes ein. Sobald die Verbindung steht, erscheint hier eine Bestätigung.\n\nFahre anschließend auf beiden Telefonen mit der Einrichtung fort.";
"setup.link.child" = "Erstelle während der Einrichtung auf dem Telefon des Elternteils einen Verbindungscode und gib ihn unten ein. Ist die Einrichtung bereits abgeschlossen, findest du die Funktion unter Einstellungen → Verbindung zum Kind.";
"setup.link.wait" = "Warten auf das Telefon des Kindes";
"setup.link.required" = "Verbinde zuerst das Telefon des Elternteils mit dem Telefon des Kindes. Das ist auch später möglich.";
"setup.pin.parent" = "Lege eine vierstellige PIN fest. Sie schützt die Elterneinstellungen auf dem Telefon deines Kindes.\n\nGib diese PIN nach dem Speichern auf dem Telefon deines Kindes ein, um die Einrichtung fortzusetzen.";
"setup.pin.child" = "Lege auf dem Telefon des Elternteils im PIN-Schritt oder in den Einstellungen eine PIN fest. Das ist nur vom Telefon des Elternteils aus möglich.\n\nGib sie anschließend hier ein, um Apps auszuwählen und den Schutz einzurichten. Ist sie noch nicht angekommen, tippe auf „Verbindung prüfen“.";
"setup.pin.verify" = "PIN empfangen. Gib sie auf diesem Telefon ein, um die Elterneinstellungen zu öffnen.";
"setup.apps.body" = "Wähle Apps, Kategorien oder Websites, für die Limits und Sperren gelten sollen. Andere Apps bleiben verfügbar.\n\nZum Ändern der Auswahl ist die Eltern-PIN erforderlich.";
"setup.protection.action_body" = "Über die Apple-Familienfreigabe kannst du verhindern, dass dein Kind die App löscht. Dafür ist ein Kinderaccount in deiner Familiengruppe nötig.\n\nDu kannst den Schutz später in den Einstellungen aktivieren. Die App funktioniert auch ohne diesen Schutz, kann dann aber vom Kind gelöscht werden.";
"setup.protection.later" = "Später einrichten";
"setup.limit.child" = "Lege auf dem Telefon des Elternteils ein Tageslimit fest.";
"setup.limit.initial" = "Starte mit 60 Minuten pro Tag. Tippe auf „Weiter“, um dieses Limit zu übernehmen, oder passe die Zeit an.";
"setup.check.title" = "Einrichtung prüfen";
"setup.check.parent" = "Hier siehst du den Einrichtungsstand auf diesem Telefon. Tippe auf einen Punkt, um dorthin zurückzukehren.\n\nSchließe auch die Einrichtung auf dem Telefon deines Kindes ab: Berechtigungen erteilen und die zu sperrenden Apps auswählen. Übersprungene Schritte kannst du später in den Einstellungen nachholen.";
"setup.check.child" = "Prüfe die Einstellungen unten. Tippe auf einen Punkt, um dorthin zurückzukehren. Der Schutz vor dem Löschen ist optional.\n\nÜbersprungene Schritte kannst du später nachholen. Beim Abschluss wird der Elternmodus beendet.";
