// Role-specific text onboarding.
"setup.parent.title" = "Gestiona el tiempo de tu hijo";
"setup.parent.body" = "Configura un límite diario, horarios y tareas que dan tiempo adicional en las apps como recompensa. Consulta el tiempo restante y solicita la ubicación de tu hijo.\n\nEn tu teléfono solo necesitamos permiso para las notificaciones. Los demás permisos se configuran en el teléfono de tu hijo.";
"setup.child.title" = "Configura el teléfono de tu hijo";
"setup.child.body" = "Completad estos pasos con el padre o la madre. Los permisos permiten registrar el tiempo en las apps elegidas, aplicar restricciones y mostrar la ubicación al progenitor.";
"setup.screen_time.body" = "Permite el acceso a Tiempo de uso para registrar el uso de las apps elegidas y bloquearlas según el límite, el horario o la indicación del padre o la madre.\n\nSin este permiso, las restricciones no funcionarán.";
"setup.notifications.child.body" = "Permite las notificaciones para que tu hijo vea los cambios de tiempo disponible, los bloqueos y los mensajes sobre tareas.\n\nSi las desactivas, puede perderse mensajes importantes.";
"setup.location.body" = "Para que el padre o la madre pueda saber dónde está su hijo, permite el acceso a la ubicación: primero Al usar la app y después Siempre.\n\nLa ubicación solo se consulta cuando se solicita. Para determinar la ubicación, se necesita el permiso Siempre.";
"setup.pairing.title" = "Conecta los dos teléfonos";
"setup.parent.pairing_body" = "En tu teléfono, abre Ajustes → Conexión con el hijo y crea un código de vinculación.\n\nInstala esta misma app en el teléfono de tu hijo y elige Teléfono del niño. Tras la configuración, introduce el código en su pantalla principal.";
"setup.protection.body" = "Para impedir que tu hijo elimine la app, su cuenta infantil debe formar parte de un grupo de En familia de Apple.\n\nTras vincular los teléfonos, activa la protección en el teléfono del niño: Padre → PIN → Ajustes → Protección contra eliminación.\n\nLa app también funciona sin esta protección, pero el niño podrá eliminarla.";
"setup.finish.title" = "Siguientes pasos";
"setup.parent.finish_body" = "Tras vincular los teléfonos, establece un PIN parental en Ajustes. Protege los ajustes del teléfono de tu hijo.\n\nConfigura el límite diario en la pantalla principal. Solo se aplica a las apps elegidas en el teléfono de tu hijo.";
"setup.child.finish_body" = "En la pantalla principal, introduce el código del teléfono del padre o la madre.\n\nTras la vinculación, el progenitor debe establecer un PIN en su propio teléfono. Después, en este teléfono: Padre → PIN → Lista de bloqueo, elegid las apps que se controlarán.\n\nEl límite diario se establece desde el teléfono del progenitor.";
"setup.permission.enabled" = "Permitido";
"setup.permission.missing" = "Sin activar";
"setup.finish.action" = "Abrir la app";
"setup.back" = "Atrás";
"role.select.parent" = "Teléfono del padre o la madre";
"role.select.child" = "Teléfono del niño";

// Guided pairing and setup.
"setup.install.title" = "Instala la app en el teléfono del niño";
"setup.install.body" = "El teléfono de tu hijo necesita esta misma app. [Envía el enlace a tu hijo](%@) o escanea el código QR con la cámara de su teléfono para instalarla.\n\nAl abrirla por primera vez, elige «Teléfono del niño»; después vincularemos los teléfonos.";
"setup.install.qr.accessibility" = "Código QR para instalar la app desde el App Store";
"setup.link.parent" = "Crea un código de vinculación e introdúcelo en el teléfono de tu hijo. Aquí aparecerá la confirmación cuando estén vinculados.\n\nDespués, continúa la configuración en ambos teléfonos.";
"setup.link.child" = "En el teléfono del padre o la madre, crea un código durante la configuración e introdúcelo abajo. Si ya se ha completado la configuración, puedes crearlo en Ajustes → Conexión con el hijo.";
"setup.link.wait" = "Esperando al teléfono del niño";
"setup.link.required" = "Primero vincula el teléfono del padre o la madre con el del niño. Puedes hacerlo más tarde.";
"setup.pin.parent" = "Crea un PIN de cuatro dígitos para proteger el acceso a los ajustes parentales en el teléfono de tu hijo.\n\nUna vez guardado, introduce ese PIN en su teléfono para continuar la configuración.";
"setup.pin.child" = "Crea un PIN en el teléfono del padre o la madre, durante la configuración del PIN o en Ajustes. Solo se puede establecer desde ese teléfono.\n\nDespués, introdúcelo aquí para elegir apps y configurar la protección. Si aún no se ha recibido, pulsa «Comprobar conexión».";
"setup.pin.verify" = "PIN recibido. Introdúcelo en este teléfono para acceder a los ajustes parentales.";
"setup.apps.body" = "Elige las apps, categorías o sitios web a los que se aplicarán los límites y bloqueos. Las demás apps seguirán disponibles.\n\nPara cambiar la selección se necesita el PIN parental.";
"setup.protection.action_body" = "También puedes impedir que tu hijo elimine la app mediante En familia de Apple. Necesitas una cuenta infantil dentro del grupo familiar.\n\nPuedes activar la protección más tarde en Ajustes. La app funciona sin esta protección, pero tu hijo podrá eliminarla.";
"setup.protection.later" = "Configurar más tarde";
"setup.limit.child" = "Establece un límite diario en el teléfono del padre o la madre.";
