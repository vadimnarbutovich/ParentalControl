"setup.child.finish_body" = "Στην αρχική οθόνη εισαγάγετε τον κωδικό από τον γονέα.\n\nΜετά ο γονέας ορίζει PIN στο δικό του τηλέφωνο. Εδώ: Γονέας → PIN → Λίστα αποκλεισμού, επιλέξτε εφαρμογές.\n\nΤο ημερήσιο όριο ορίζεται στο τηλέφωνο του γονέα.";
"setup.child.title" = "Ρύθμιση τηλεφώνου παιδιού";
"setup.finish.action" = "Άνοιγμα εφαρμογής";
"setup.finish.title" = "Επόμενα βήματα";
"setup.install.body" = "Στο τηλέφωνο του παιδιού χρειάζεται η ίδια εφαρμογή. [Στείλτε τον σύνδεσμο](%@) ή σαρώστε το QR με την κάμερά του για εγκατάσταση.\n\nΣτην πρώτη εκκίνηση επιλέξτε «Τηλέφωνο παιδιού». Έπειτα θα συνδέσουμε τα τηλέφωνα.";
"setup.install.qr.accessibility" = "Κωδικός QR εγκατάστασης από το App Store";
"setup.install.title" = "Η εφαρμογή στο τηλέφωνο του παιδιού";
"setup.limit.child" = "Ορίστε το ημερήσιο όριο στο τηλέφωνο του γονέα.";
"setup.limit.initial" = "Ξεκινήστε με 60 λεπτά την ημέρα. Πατήστε Επόμενο ή αλλάξτε το όριο.";
"setup.link.child" = "Στο τηλέφωνο του γονέα δημιουργήστε κωδικό στη ρύθμιση και εισαγάγετέ τον εδώ. Αν η ρύθμιση τελείωσε: Ρυθμίσεις → Σύνδεση με παιδί.";
"setup.link.parent" = "Δημιουργήστε κωδικό σύνδεσης και εισαγάγετέ τον στο τηλέφωνο του παιδιού. Η επιβεβαίωση θα εμφανιστεί εδώ.\n\nΜετά συνεχίστε τη ρύθμιση και στα δύο τηλέφωνα.";
"setup.link.required" = "Συνδέστε πρώτα τα τηλέφωνα γονέα και παιδιού. Μπορείτε και αργότερα.";
"setup.link.wait" = "Αναμονή τηλεφώνου παιδιού";
"setup.location.body" = "Για να βλέπει ο γονέας την τοποθεσία του παιδιού, δώστε πρώτα πρόσβαση «Κατά τη χρήση της εφαρμογής» και μετά «Πάντα».\n\nΗ τοποθεσία ελέγχεται μόνο κατόπιν αιτήματος γονέα. Για αυτή τη λειτουργία χρειάζεται «Πάντα».";
"setup.notifications.child.body" = "Ενεργοποιήστε ειδοποιήσεις για αλλαγές χρόνου, αποκλεισμούς και μηνύματα εργασιών.\n\nΧωρίς αυτές, το παιδί μπορεί να χάσει σημαντικά μηνύματα.";
"setup.pairing.title" = "Σύνδεση των δύο τηλεφώνων";
"setup.parent.body" = "Ορίστε όριο, προγράμματα και εργασίες με ανταμοιβή επιπλέον χρόνο στις εφαρμογές. Δείτε το υπόλοιπο και ζητήστε την τοποθεσία του παιδιού.\n\nΣτο τηλέφωνό σας αρκούν οι ειδοποιήσεις. Οι άλλες άδειες δίνονται στο τηλέφωνο του παιδιού.";
"setup.parent.finish_body" = "Μετά τη σύνδεση ορίστε PIN γονέα στις Ρυθμίσεις. Προστατεύει τις ρυθμίσεις στο τηλέφωνο του παιδιού.\n\nΟρίστε ημερήσιο όριο στην αρχική οθόνη· ισχύει μόνο για τις εφαρμογές που επιλέχθηκαν στο τηλέφωνο του παιδιού.";
"setup.parent.pairing_body" = "Στο τηλέφωνό σας: Ρυθμίσεις → Σύνδεση με παιδί, δημιουργήστε κωδικό.\n\nΕγκαταστήστε την ίδια εφαρμογή στο τηλέφωνο του παιδιού και επιλέξτε Τηλέφωνο παιδιού. Μετά τη ρύθμιση εισαγάγετε τον κωδικό στην αρχική οθόνη του.";
"setup.parent.title" = "Διαχείριση χρόνου οθόνης";
"setup.permission.enabled" = "Επιτρέπεται";
"setup.permission.missing" = "Δεν ενεργοποιήθηκε";
"setup.pin.child" = "Το PIN ορίζεται μόνο στο τηλέφωνο του γονέα, στο βήμα PIN γονέα ή στις Ρυθμίσεις.\n\nΕισαγάγετέ το εδώ για επιλογή εφαρμογών και προστασία. Αν δεν έφτασε, πατήστε Έλεγχος σύνδεσης.";
"setup.pin.enter" = "Εισαγωγή PIN";
"setup.pin.parent" = "Ορίστε τετραψήφιο PIN για τις ρυθμίσεις γονέα στο τηλέφωνο του παιδιού.\n\nΑποθηκεύστε το και εισαγάγετέ το εκεί για συνέχεια.";
"setup.pin.verify" = "Το PIN ελήφθη. Εισαγάγετέ το εδώ για τις ρυθμίσεις γονέα.";
"setup.protection.action_body" = "Μπορείτε να εμποδίσετε τη διαγραφή μέσω της Οικογενειακής κοινής χρήσης Apple. Χρειάζεται παιδικός λογαριασμός στην οικογένειά σας.\n\nΕνεργοποιείται και αργότερα στις Ρυθμίσεις. Χωρίς προστασία η εφαρμογή λειτουργεί, αλλά το παιδί μπορεί να τη διαγράψει.";
"setup.protection.body" = "Για προστασία διαγραφής, ο παιδικός λογαριασμός πρέπει να είναι σε ομάδα Οικογενειακής κοινής χρήσης Apple.\n\nΜετά τη σύνδεση, στο τηλέφωνο του παιδιού: Γονέας → PIN → Ρυθμίσεις → Προστασία διαγραφής.\n\nΧωρίς προστασία η εφαρμογή λειτουργεί, αλλά μπορεί να διαγραφεί.";
"setup.protection.later" = "Ρύθμιση αργότερα";
"setup.refresh" = "Έλεγχος σύνδεσης";
"setup.screen_time.body" = "Επιτρέψτε τον Χρόνο επί οθόνης για μέτρηση και αποκλεισμό επιλεγμένων εφαρμογών όταν τελειώσει το όριο, βάσει προγράμματος ή με εντολή γονέα.\n\nΧωρίς αυτή την άδεια οι περιορισμοί δεν λειτουργούν.";
